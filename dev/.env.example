# Template for dev/.env — copy to dev/.env and fill in real values.
# dev/.env is gitignored; this file documents which variables exist.
# Usage: set -a; source dev/.env; set +a

# Remote build Mac
MAC_HOST="user@host"
MAC_PASSWORD_FILE="/path/to/file-containing-password"

# Apple Developer account
APPLE_ID_EMAIL="you@example.com"
APPLE_TEAM_ID="XXXXXXXXXX"
APPLE_DEV_CERT_ID="XXXXXXXXXX"
APPLE_CERT_CN="Your Name"
P12_PASSWORD="choose-a-temp-password"

# Production community-site deployment
DEPLOY_SCRIPT="/path/to/deploy-watch.sh"
DEPLOY_HOST="your-server"
DEPLOY_REMOTE_PATH="/remote/deploy/path"

# Backend test credentials (local Laravel dev DB)
TEST_USER3_PASSWORD=""
